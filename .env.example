# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated allowlist for BOTH the REST API and the Socket.IO gateway.
# There is more than one frontend: the vendor/admin web app and the customer PWA.
# In development localhost 3000/5173/4173/5174/4174 are always allowed as well —
# the marketing site, the customer app, and the vendor app.
#
# REQUIRED in every deployed environment — the app refuses to boot without it when
# NODE_ENV=production, because an empty allowlist locks out every frontend. Staging and
# production both run as NODE_ENV=production and point at different frontends, so each
# Render service sets its own value. No trailing slashes: a browser's Origin header has
# none, and the match is exact.
#   staging:    https://recommend-fe.vercel.app,https://recommend-vendors.vercel.app,https://recommend-customer-app.vercel.app
#   production: the live domains
FRONTEND_URLS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Where a SELLER's password-reset link points. Vendors manage their business in the
# vendor PWA, not on the marketing site. Unset falls back to FRONTEND_URL.
VENDOR_APP_URL=http://localhost:5174

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/recommend
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true

# A managed Postgres (Aiven, Render, Neon, Supabase) signs with its own CA, and recent pg
# reads `sslmode=require` in the URL as full verification — so without one of the two
# settings below, both the app and `yarn migration:run` fail with
# "self-signed certificate in certificate chain". Leave both unset for a local Postgres.
#
# Preferred: the provider's CA certificate (Aiven: Connection information → CA
# certificate). The connection is encrypted AND verified. Paste the whole PEM, either on
# one line with \n between lines, or across lines inside double quotes:
#   DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----"
# Not a secret — the CA is public — but it belongs to one database, so set it per environment.
DATABASE_CA_CERT=
#
# Fallback when the provider gives no CA: encrypted, but the chain check is skipped.
# Ignored when DATABASE_CA_CERT is set.
DATABASE_SSL=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-too
JWT_REFRESH_EXPIRES_IN=30d

# Redis
# Managed Redis (Upstash, Redis Cloud): one URL carrying scheme, credentials and TLS.
# rediss:// (two s) means TLS. Takes precedence over REDIS_HOST/PORT/PASSWORD below.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=86400

# WhatsApp
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI — powers chat discovery.
# Leaving OPENAI_API_KEY blank is supported: discovery falls back to keyword search,
# which still returns real vendors and dishes, just without conversation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Higher sounds more like a person, lower more predictable. Prices are safe either way —
# the model's words never carry them.
OPENAI_TEMPERATURE=0.6

# What the assistant calls itself, in the greeting and in conversation.
ASSISTANT_NAME=James

# Chat cost controls
# How many past messages go to the model on every turn. The main lever on per-turn
# token cost — every extra message is paid for on every turn of every conversation.
# Capped at 100 by ConversationService.getHistory(); a higher value clamps silently.
CHAT_MAX_HISTORY_MESSAGES=100
# Tool round-trips allowed per turn, so a confused model cannot loop.
CHAT_MAX_TOOL_ROUNDS=3

# Per-session chat limits. A WebSocket bypasses ThrottlerModule entirely, so without
# these one client can loop messages and spend the OpenAI budget unchecked. Counters
# live in Redis so the limit holds across instances.
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_HOUR=200

# How long an admin who has taken over a conversation can be silent before a waiting
# buyer gets the assistant back. Checked only when the buyer sends something, so the
# assistant never interrupts a live human conversation — and nobody waits on an admin
# who has gone home.
ADMIN_HANDOVER_STALE_MINUTES=30

# When a buyer is handed to the team, how many minutes without an admin taking the chat
# before they are told, once, that the team is busy. The assistant keeps chatting meanwhile.
CHAT_HANDOVER_NOTICE_MINUTES=3

# Signs the chat's device tokens. Keep it different from JWT_SECRET — those tokens are
# handed to anyone who opens the chat. Optional: derived from JWT_SECRET when unset.
CHAT_SESSION_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=


# Email — Brevo's HTTP API, not SMTP.
# These two are the ones `EmailService` actually reads. Without them every email is
# skipped: order alerts to vendors, payout-account verification codes, password resets.
# Until vendors are receiving web push, email is the only channel that reaches them.
BREVO_API_KEY=
# Must be a sender Brevo has verified for your account, or it rejects the send.
BREVO_SENDER_EMAIL=noreply@recommend.ng

# Payments
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# Super Admin bootstrap (used once on first startup if no SUPER_ADMIN exists)
SUPER_ADMIN_EMAIL=admin@yourapp.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Contact form
# Where the website's contact form is emailed (via Brevo, so BREVO_* must be set). The
# visitor is the reply-to. Caps are per hour: per sender, and for all messages together.
CONTACT_INBOX=contacts.recommend@gmail.com
CONTACT_MAX_PER_SENDER_PER_HOUR=5
CONTACT_MAX_PER_HOUR=60

# Welcome email
# Sent once, at a new user's first verification. Its logo is served from the website
# (/email/recommend-logo.png), and its buttons open the apps. Unset app URLs fall back to
# the website; replies go to CONTACT_INBOX.
WEBSITE_URL=https://recommend-fe.netlify.app
CUSTOMER_APP_URL=

# Delivery
# Flat fee charged once per checkout when fulfillment is DELIVERY. Snapshotted onto the
# checkout row at order time, so changing it never re-prices past orders.
DELIVERY_FEE_NGN=1500

# Platform commission
# Recommend's cut of each vendor's goods subtotal, as an INTEGER PERCENTAGE — 20 means 20%.
# Not a rate: a bare 0.2 here invites someone to "correct" it to 20 and take 2,000%.
# Refused at boot outside 0-100, because every plausible typo is expensive.
# Like the delivery fee above, changing it never re-prices a placed order — platformFee and
# vendorAmount are written onto the order row at checkout and never recomputed.
PLATFORM_FEE_PERCENT=20

# Wallet and payout accounts
# Pending accounts do NOT count towards the maximum — the cap is enforced when an account
# is verified, so someone with 3 verified and 1 pending is not told they already have 4.
MAX_PAYOUT_ACCOUNTS=4
PAYOUT_ACCOUNT_CODE_TTL_MINUTES=15
PAYOUT_ACCOUNT_MAX_CODE_ATTEMPTS=5
PAYOUT_ACCOUNT_RESEND_SECONDS=60
# How long one password confirmation covers further sensitive actions. Asking on every
# action pushes people to a weak or browser-saved password, which protects nothing.
# Without Redis this never persists and the password is asked for every time.
PASSWORD_CONFIRMATION_TTL_MINUTES=15
BANK_LIST_CACHE_HOURS=24

# Withdrawals
# The vendor pays the Paystack transfer fee. Absorbing it would leave the amount that
# leaves their ledger permanently different from the amount that leaves our balance.
MIN_WITHDRAWAL_NGN=2000
# `upTo:fee` pairs, then `*:fee` for anything larger. Read off your Paystack pricing —
# these change, and a stale value means we quietly absorb the difference every time.
PAYSTACK_TRANSFER_FEE_TIERS=5000:10,50000:25,*:50
# A charge settles into the Paystack balance on Paystack's cycle (~T+1), so a withdrawal
# can be correct and still have nothing to send yet. It is retried rather than failed.
WITHDRAWAL_RETRY_MINUTES=30
WITHDRAWAL_MAX_ATTEMPTS=8

# REQUIRED for withdrawals, and neither is code:
#   1. Transfers must be enabled on the Paystack account.
#   2. Transfers OTP must be DISABLED in the dashboard — Paystack asks for an OTP per
#      transfer by default, which makes API-initiated withdrawal impossible.

# Web Push (VAPID) — vendor dashboard notifications
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@recommend.ng